const LABELS := ["P1", "P6", "P5", "P4", "P3", "P2"]
const RECEIVE := [
	[[2.90,5.35],[0.0,.60],[-4.0,2.40],[-3.30,5.40],[-.20,6.55],[4.0,6.85]],
	[[3.10,5.25],[3.75,2.45],[0.0,.70],[-2.90,5.25],[0.0,6.05],[1.0,1.90]],
	[[0.0,6.70],[3.15,5.40],[3.60,2.50],[-3.20,5.40],[-3.85,.60],[-1.20,1.30]],
	[[0.0,7.00],[2.85,5.75],[3.80,7.25],[-2.90,5.80],[-3.20,1.50],[-4.0,.60]],
	[[-2.90,5.40],[.05,6.45],[1.65,7.20],[3.10,5.45],[.70,1.75],[.15,.60]],
	[[-2.90,5.50],[-3.85,.65],[-1.30,8.0],[-.10,6.70],[2.80,5.45],[1.20,.60]]
]
const DEFENSE := [
	[[3.40,.68],[0.0,.68],[-3.40,.68],[0.0,5.35],[-2.85,4.65],[2.85,4.65]],
	[[0.0,5.35],[0.0,.68],[3.40,.68],[-3.40,.68],[-2.85,4.65],[2.85,4.65]],
	[[0.0,5.35],[-2.85,4.65],[3.40,.68],[-3.40,.68],[0.0,.68],[2.85,4.65]],
	[[0.0,5.35],[-2.85,4.65],[2.85,4.65],[-3.40,.68],[0.0,.68],[3.40,.68]],
	[[-3.40,.68],[-2.85,4.65],[2.85,4.65],[0.0,5.35],[0.0,.68],[3.40,.68]],
	[[-3.40,.68],[0.0,.68],[2.85,4.65],[0.0,5.35],[-2.85,4.65],[3.40,.68]]
]
## Separate first side-out preparation, from the six additional user diagrams.
## These are approach/support anchors, not forced hand-contact coordinates.
const FIRST_ATTACK := [
	[[4.0,2.45],[0.0,2.45],[-4.0,2.45],[-1.95,4.25],[1.55,4.25],[1.55,.65]],
	[[1.85,4.15],[0.0,2.45],[4.0,2.45],[-4.0,2.45],[-2.0,4.25],[1.85,.65]],
	[[-1.85,4.20],[1.55,4.20],[4.0,2.45],[-4.0,2.45],[0.0,2.45],[1.55,.65]],
	[[-1.85,4.20],[1.45,4.20],[4.0,4.30],[-4.0,2.45],[0.0,2.45],[1.45,.65]],
	[[-4.0,2.45],[-2.0,4.20],[4.0,4.05],[1.45,4.25],[-.35,2.45],[1.45,.65]],
	[[-4.0,2.45],[-.70,2.45],[4.0,4.15],[-1.85,4.25],[.85,4.25],[1.15,.65]]
]

static func first_attack(index: int, rotation: int) -> Vector3:
	return point(FIRST_ATTACK,index,rotation)

static func point(table: Array, index: int, rotation: int) -> Vector3:
	var p: Array=table[posmod(rotation,6)][index%6]
	return Vector3(p[0],0,p[1])

static func defense(index: int, rotation: int) -> Vector3:
	return point(DEFENSE,index,rotation)

static func label(rotation: int) -> String:
	return LABELS[posmod(rotation,6)]
