extends RefCounted
## All lessons are available immediately. No changes to match controls/timing.
static func say(it: String, en: String) -> String:
	return en if TranslationServer.get_locale().begins_with("en") else it

static func categories() -> Array:
	return [
		{"id":"serve","name":say("Servizio","Serving"),"tag":"01","subtitle":say("Carica, mira, scegli la battuta.","Charge, aim and choose your serve."),"color":Color("edc46b")},
		{"id":"receive","name":say("Ricezione e difesa","Passing & digging"),"tag":"02","subtitle":say("Leggi la palla e trova il contatto.","Read the ball and time your contact."),"color":Color("5bd9d1")},
		{"id":"set","name":say("Palleggio","Setting"),"tag":"03","subtitle":say("Scegli attaccante, direzione e tempo.","Choose the hitter, direction and tempo."),"color":Color("7eb8ff")},
		{"id":"attack","name":say("Schiacciata","Attacking"),"tag":"04","subtitle":say("Rincorsa, potenza e colpo di polso.","Approach, power and wrist disguise."),"color":Color("ef927f")},
		{"id":"block","name":say("Muro","Blocking"),"tag":"05","subtitle":say("Chiudi la rete e comanda il salto.","Close the net and command the jump."),"color":Color("b3a0ed")}
	]

static func lesson(id: String, it: String, en: String, body_it: String, body_en: String, extra: Dictionary={}) -> Dictionary:
	var item={"id":id,"title":say(it,en),"body":say(body_it,body_en),"goal":2}
	item.merge(extra)
	return item

static func all(category: String) -> Array:
	match category:
		"serve": return [
			lesson("jump","Battuta al salto","Jump serve","Tieni premuto Croce (PS) / A (Xbox), poi rilascia. La barra verde cresce una volta sola: più carichi, più la palla è veloce. Cerca il 55–90% e manda due battute dentro.","Hold Cross (PS) / A (Xbox), then release. The green bar fills once: more charge means a faster ball. Serve in twice at 55–90%.",{"style":1,"min":.55,"max":.90}),
			lesson("float","Battuta float","Float serve","Tieni premuto Quadrato (PS) / X (Xbox) e rilascia al 55–90%. È una battuta diversa dal salto: usa la stessa logica di carica e mira.","Hold Square (PS) / X (Xbox), releasing at 55–90%. This is a different serve from the jump serve, using the same charge and aim logic.",{"style":0,"min":.55,"max":.90}),
			lesson("right","Mira: fondo a destra","Aim: deep right","Durante la carica usa la levetta SINISTRA verso destra e in avanti (su): il bersaglio è nell'angolo destro lontano. Puoi usare salto o float. Conta il punto di caduta, non soltanto la direzione scelta.","While charging, point the LEFT stick right and forward (up). Aim at the far right corner. Either serve is valid. The actual landing, not just your input, must hit the target.",{"zone":Vector2(2.8,-7.0),"radius":2.0,"min":.25,"max":1.0}),
			lesson("left","Mira: fondo a sinistra","Aim: deep left","Mira con la levetta SINISTRA verso sinistra e in avanti. Durante la carica su manda più lungo, giù più corto. La mira resta riferita al campo anche se cambi posizione in battuta.","Aim the LEFT stick left and forward. While charging, up serves deeper and down shorter. Aim remains relative to the court when you change your serving position.",{"zone":Vector2(-2.8,-7.0),"radius":2.0,"min":.25,"max":1.0}),
			lesson("move","Scegli il punto di battuta","Choose your starting position","PRIMA di caricare, la levetta sinistra sposta il battitore: arretra o vai di lato di almeno 80 cm. Non puoi entrare nel campo. Dopo aver iniziato la carica, la stessa levetta diventa la mira. Poi batti dentro.","BEFORE charging, move the server backwards or sideways with the left stick by at least 80 cm. You cannot enter the court. Once charging starts, the same stick aims the serve. Then serve in.",{"move":.8,"min":.25,"max":1.0}),
			lesson("power","Vicino alla massima potenza","Near maximum power","Rilascia tra il 95 e il 100%. Solo il 100% visualizzato, senza superarlo, attiva l'ace garantito del gioco. Qui basta stare nella fascia 95–100% e servire dentro: puoi riprovare liberamente per cercare il 100%.","Release at 95–100%. Only a displayed 100%, without overcharging, activates the game's guaranteed ace. This lesson accepts a legal serve in the 95–100% band; keep practising for exactly 100%.",{"min":.95,"max":1.000001}),
			lesson("over","Capire il sovraccarico","Understand overcharging","Prova a rilasciare tra il 105 e il 125%. La velocità continua a crescere oltre il 100%, ma aumentano gli errori in rete o fuori. In questa prova conta sperimentare la carica: anche l'errore è un risultato utile.","Try releasing at 105–125%. Ball speed keeps increasing above 100%, but net and out errors become more likely. This experiment accepts the overcharge even if the serve faults.",{"min":1.05,"max":1.25,"experiment":true})]
		"receive": return [
			lesson("contact","Il primo contatto","Your first pass","Premi UNA VOLTA Croce (PS) / A (Xbox) quando la palla sta arrivando al ricevitore evidenziato. Non tenere premuto e non usare una barra. Il movimento è automatico. Ottieni due contatti con qualità almeno 55%.","Press Cross (PS) / A (Xbox) ONCE as the ball approaches the highlighted passer. Do not hold it: there is no charge bar. Movement is automatic. Make two passes with at least 55% quality.",{"quality":.55,"feed":1.15}),
			lesson("perfect","Ricezione precisa","Accurate passing","Aspetta un po' di più prima di premere Croce / A: anticipare troppo peggiora la ricezione. Il feedback distingue anticipo e ritardo. Cerca almeno 80%: una buona ricezione facilita il palleggiatore, una cattiva lo allontana dalla rete.","Wait a little longer before pressing Cross / A: pressing too early weakens the pass. Feedback distinguishes early and late timing. Reach at least 80%: good passing helps the setter; bad passing pulls them away from the net.",{"quality":.80,"feed":.98}),
			lesson("pace","Ricevere una palla più veloce","Pass a faster ball","Il lancio arriva più rapidamente, ma il comando non cambia: Croce / A vicino al contatto. La mira della ricezione è automatica verso la zona di alzata; conta il tempismo, non spostare la levetta per rincorrere la palla.","The feed arrives faster, but the control is the same: Cross / A close to contact. Pass direction is automatic towards the setting area; focus on timing rather than chasing with the stick.",{"quality":.65,"feed":.74}),
			lesson("dig","Difesa su attacco","Dig a hard attack","Ora arriva un attacco. Premi Croce / A in prossimità del contatto. Con potenza alta e tempismo imperfetto la palla può restare corta, lunga o laterale. Il tuffo e il recupero sono contestuali, non un nuovo tasto. Cerca almeno 55%.","Now face an attack. Press Cross / A near contact. A hard hit and imperfect timing can produce a short, deep or sideways dig. Diving and recovery are contextual, not a separate button. Reach at least 55%.",{"quality":.55,"feed":.64,"dig":true}),
			lesson("recovery","Finestra di recupero","Late recovery window","C'è una finestra tardiva molto breve, fino a 0,12 secondi dopo il contatto previsto. Premi Croce / A: il gioco sceglie un recupero se la palla è ancora raggiungibile. Prova a salvare due palloni: il ritardo non garantisce un tuffo né il recupero.","A very small late window extends up to 0.12 seconds after expected contact. Press Cross / A: the game chooses a recovery if the ball is still reachable. Save two balls; being late does not guarantee a dive or a save.",{"quality":.20,"feed":.82,"dig":true,"explore_recovery":true})]
		"set":
			var result: Array=[]
			for fast in [false,true]:
				for direction in [0,2,3,1]:
					var names=[say("Banda · zona 4","Outside · zone 4"),say("Primo tempo","First tempo"),say("Opposto · zona 2","Opposite · zone 2"),say("Pipe · seconda linea","Pipe · back row")]
					var dirs=[say("sinistra","left"),say("su","up"),say("destra","right"),say("giù","down")]
					var name: String=names[direction]
					if fast and direction==1: name=say("7 del centrale","Middle's wide quick (7)")
					elif fast: name+=" · "+say("veloce","quick")
					var body: String=say("Prima del contatto, scegli ","Before contact, select ")+dirs[direction]+say(" con la levetta SINISTRA, poi premi UNA VOLTA "," with the LEFT stick, then press ONCE ")+(say("Quadrato (PS) / X (Xbox)","Square (PS) / X (Xbox)") if fast else say("Croce (PS) / A (Xbox)","Cross (PS) / A (Xbox)"))+say(". Non si carica il palleggio. La prova riparte dopo il tocco: qui controlli solo il palleggiatore.",". Setting has no charge bar. The drill repeats after your set: you only control the setter here.")
					if direction==1: body+=say(" Scegli in anticipo: Croce/A è il primo tempo vicino, Quadrato/X la 7 più larga. Il centrale prepara già la finta."," Choose early: Cross/A is the closer first tempo; Square/X is the wider 7. The middle is already preparing a decoy.")
					if direction==3: body+=say(" La pipe è un attacco di seconda linea; la veloce è un po' più bassa e immediata."," Pipe is a back-row attack; its quick set is a little lower and earlier.")
					result.append(lesson("set_%d_%s"%[direction,str(fast)],name,name,body,body,{"direction":direction,"fast":fast}))
			result.append(lesson("dump","Colpo di seconda","Setter dump","Vicino alla rete e con il palleggiatore di prima linea, premi Cerchio (PS) / B (Xbox): spingi la palla di seconda oltre la rete. La levetta sinistra mira. Lontano dalla rete il comando torna a un'alzata normale: non è una schiacciata da ogni posizione.","Near the net with a front-row setter, press Circle (PS) / B (Xbox) to push the ball over on second contact. Aim with the left stick. Away from the net it falls back to a normal set: it is not an attack available everywhere.",{"dump":true,"direction":0,"fast":false}))
			return result
		"attack": return [
			lesson("swing","La schiacciata","The spike","La ricezione e l'alzata vengono preparate per te. Durante la rincorsa tieni Croce (PS) / A (Xbox), poi rilascia prima del colpo. Cerca 55–90% e attacca dentro. Non devi muovere l'attaccante: la levetta SINISTRA serve per mirare.","The pass and set are prepared for you. During the approach hold Cross (PS) / A (Xbox), releasing before contact. Hit in at 55–90%. You do not move the hitter: the LEFT stick aims.",{"direction":0,"min":.55,"max":.9}),
			lesson("line","Lungolinea","Down the line","Dalla banda in zona 4, mira in avanti a sinistra con la levetta SINISTRA e carica Croce / A. Cerca il bersaglio lungo linea. La mira ha otto settori; più potenza significa anche meno precisione.","From the outside in zone 4, aim forward-left with the LEFT stick and charge Cross / A. Hit the line target. Aim has eight sectors; more power also means less precision.",{"direction":0,"zone":Vector2(-3.2,-7.0),"radius":2.0,"min":.25,"max":1.0}),
			lesson("cross","Diagonale","Cross-court","Dalla zona 4 mira in avanti a destra per la diagonale lunga. Per la diagonale corta usa indietro a destra (giù-destra): cambia la profondità del bersaglio. Qui colpisci la zona della diagonale lunga due volte.","From zone 4, aim forward-right for a deep cross-court shot. For a shorter cross, aim back-right (down-right) to change depth. In this drill hit the deep cross-court target twice.",{"direction":0,"zone":Vector2(3.2,-7.0),"radius":2.0,"min":.25,"max":1.0}),
			lesson("opposite","Opposto e seconda linea","Opposite and back-row attack","Ora ricevi l'alzata dietro all'opposto di seconda linea. Croce / A carica il colpo, levetta sinistra mira. La rincorsa, lo stacco fuori dai tre metri e l'atterraggio sono automatici. La potenza usa la stessa curva degli altri attacchi.","Now receive a back set to the back-row opposite. Cross / A charges and the left stick aims. The approach, legal takeoff behind the attack line and landing are automatic. Power uses the same curve as other attacks.",{"direction":2,"rotation":3,"min":.55,"max":1.0}),
			lesson("pipe","Pipe veloce","Quick pipe","L'alzata è più bassa e immediata. Inizia a caricare Croce / A durante la preparazione, senza aspettare che l'attaccante sia già in aria. Stacco da fuori i tre metri e contatto dentro avvengono automaticamente.","The set is lower and earlier. Start charging Cross / A during preparation, without waiting until the hitter is airborne. Takeoff behind the attack line and contact inside happen automatically.",{"direction":3,"fast":true,"min":.45,"max":1.0}),
			lesson("tip","Pallonetto di polso","Disguised wrist tip","Tieni Quadrato (PS) / X (Xbox), poi rilascia: la carica e le otto direzioni sono le stesse della schiacciata. Mira giù-destra dalla zona 4 per un pallonetto diagonale corto. Una carica maggiore rende il colpo più efficace; oltre il 100% aumenta il rischio.","Hold Square (PS) / X (Xbox), then release: charge and eight-way aim work like the spike. Aim down-right from zone 4 for a short cross-court wrist tip. More charge improves effectiveness; over 100% increases risk.",{"direction":0,"tip":true,"min":.35,"max":1.0}),
			lesson("full","Attacco potente e rischio","Hard hitting and risk","Prova una carica fra 90 e 100% con Croce / A. L'attacco ha una barra diversa e più lenta della battuta. Fra 97 e 100% il gioco attiva il colpo vincente; oltre il 100% non è sempre fuori, ma il rischio aumenta più che in battuta.","Try a 90–100% charge with Cross / A. The attack bar is slower than the serve bar. At 97–100% the game activates its winning hit; over 100% is not always out, but carries more risk than serving.",{"direction":0,"min":.90,"max":1.000001})]
		"block": return [
			lesson("single","Il salto a muro","The block jump","Controlli sempre il centrale con la levetta SINISTRA. Qui l'attacco arriva al centro: premi Croce (PS) / A (Xbox) poco prima del colpo avversario. Non devi caricare. Intercetta due palloni: non serve fare sempre punto.","Always control the middle blocker with the LEFT stick. This attack comes through the middle: press Cross (PS) / A (Xbox) shortly before the opponent hits. Do not hold for power. Touch two attacks; each touch need not score.",{"direction":3,"central_feed":true}),
			lesson("right","Chiusura a destra","Close to the right","Leggi l'alzata e muovi il centrale verso destra con la levetta SINISTRA. Il pilone sul lato dell'attacco si posiziona automaticamente; il salto lo comandi tu con Croce / A. Il laterale lontano scala in difesa.","Read the set and move the middle right with the LEFT stick. The pin blocker on the attack side positions automatically; YOU command the jump with Cross / A. The far pin drops into defense.",{"direction":0}),
			lesson("left","Chiusura a sinistra","Close to the left","Muovi il centrale verso sinistra, senza allontanarlo dalla rete. Il pilone segue il lato dell'attacco. Salta con Croce / A: chiudere bene lo spazio fra le mani conta più di saltare prestissimo.","Move the middle left while staying close to the net. The pin tracks the attack side. Jump with Cross / A: closing the hands matters more than jumping very early.",{"direction":2}),
			lesson("join_right","Richiama il pilone destro","Bring in the right pin","Tieni R2 (PS) / RT (Xbox) per avvicinare il muratore destro al centrale. Sposta la formazione con la levetta SINISTRA e premi Croce / A per il salto comune. Tieni il grilletto fino allo stacco e tocca la palla.","Hold R2 (PS) / RT (Xbox) to bring the right blocker beside the middle. Move with the LEFT stick and press Cross / A for their shared jump. Hold the trigger through takeoff and touch the ball.",{"direction":3,"central_feed":true,"right":true}),
			lesson("join_left","Richiama il pilone sinistro","Bring in the left pin","Tieni L2 (PS) / LT (Xbox), chiudi con la levetta SINISTRA e salta con Croce / A. I comandi spostano e fanno saltare giocatori reali: una chiusura tardiva può lasciare un varco.","Hold L2 (PS) / LT (Xbox), close with the LEFT stick and jump with Cross / A. These commands move real players: closing late can leave a gap.",{"direction":3,"central_feed":true,"left":true}),
			lesson("triple","Muro a tre","Triple block","Tieni entrambi i grilletti L2+R2 / LT+RT per formare il muro a tre. Muovi il centrale con la levetta sinistra e premi Croce / A per farli saltare insieme. Servono tre giocatori effettivamente coinvolti al salto.","Hold both triggers L2+R2 / LT+RT to form a triple block. Move the middle with the left stick and press Cross / A to jump together. Three actual players must be involved at takeoff.",{"direction":3,"central_feed":true,"left":true,"right":true,"members":3}),
			lesson("press","Muro pieno e rigioco","Sealed block and continuation","Cerca un contatto pieno, con le mani già alte sulla traiettoria, premendo Croce / A vicino all'attacco. Un muro chiuso può fare monster block; tocchi più morbidi restano giocabili e le dita esterne possono produrre mani fuori. Qui conta ottenere due muri pieni.","Time Cross / A so raised hands meet the attack squarely. A sealed block can score; soft touches stay playable and outside fingertips can be tooled. This lesson asks for two sealed blocks.",{"direction":0,"sealed":true})]
	return []
