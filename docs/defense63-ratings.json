    "vnl": "06186502ad30be9f66ff3db83136631d1b45ab320ea1e15a07c9e2b897dc8e4f"
  },
  "method": "Editorial 0-99 estimates: successful dig control and digs/match, sample-size shrinkage to role priors; VNL evidence weighted 0.65. Non-matched players explicitly estimated, never official ratings. Source dates 2026-10-27.",
  "formula": {
    "role_priors": {
      "libero": 88,
      "outside_hitter": 76,
      "setter": 70,
      "opposite": 65,
      "middle_blocker": 53
    },
    "measurement": "48+33*clamp((success_percent-20)/45)+15*clamp(digs_per_match/7)",
    "weight": "attempts/(attempts+90), x0.65 for VNL",
    "matched": "(role_prior+sum(measurement*weight))/(1+sum(weight))",
    "unmatched": "0.8*role_prior+0.2*existing_overall"
  },
